# ============================================================================
# Disparador WhatsApp — variáveis de ambiente
# Copie para `.env.local` (ignorado pelo git) e preencha. NUNCA commite valores reais.
# Nenhuma destas variáveis tem o prefixo VITE_, então nada daqui vai para o navegador.
# ============================================================================

# --- Banco de dados (Supabase PostgreSQL, usado SOMENTE como banco) ----------
# Supabase > Project Settings > Database > Connection string.
# Para deploy em ambiente serverless/edge prefira a string do pooler (Transaction pooler).
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres

# Criptografia da conexão: require (padrão; criptografa sem validar o certificado),
# verify (valida o certificado; recomendado em produção) ou disable (apenas banco local).
DATABASE_SSL=require
# Com DATABASE_SSL=verify, cole aqui o certificado da CA (conteúdo PEM) baixado no painel do Supabase.
# DATABASE_CA_CERT=

# Tamanho máximo do pool de conexões deste servidor.
DATABASE_POOL_MAX=5

# --- Sessão e senhas ----------------------------------------------------------
# Duração da sessão em horas (padrão 168 = 7 dias).
SESSION_TTL_HOURS=168
# Custo do bcrypt (padrão 12; em produção o mínimo aceito é 10).
BCRYPT_COST=12

# Origens extras autorizadas a chamar a API (separadas por vírgula).
# Só é necessário se o app ficar atrás de um proxy que altere o domínio visto pelo servidor.
# ALLOWED_ORIGINS=https://disparador.suaempresa.com.br

# --- HubSpot (integração já existente; opcional) ---------------------------------
# Token de app privado do HubSpot. Fica apenas no servidor.
# HUBSPOT_TOKEN=
# HUBSPOT_API_TARGET=https://api.hubapi.com
